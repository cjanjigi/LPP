module

public import Differentiability.FinalDraft.StairGeometry.Event
public import Mathlib.MeasureTheory.MeasurableSpace.Defs
import LPP_Foundations.Model.Paths.Fintype
import Mathlib.Tactic

/-! The staircase geometry events are measurable using only the bad-site indicators. -/

@[expose] public section

open MeasureTheory Set

namespace LPPDifferentiability.StairGeometry

/-- The sigma-algebra generated by the very-bad-site indicators. -/
@[instance_reducible] def badSiteSigma (T : ℝ) : MeasurableSpace Environment :=
  MeasurableSpace.generateFrom (Set.range fun z : Lattice => {ω : Environment | ω z < -T})

/-- The threshold at each site is one of the generators. -/
theorem measurableSet_site_bad (T : ℝ) (z : Lattice) :
    MeasurableSet[badSiteSigma T] {ω : Environment | ω z < -T} :=
  MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self z)

private theorem measurable_all {T : ℝ} {ι : Type*} [Countable ι] (p : ι → Environment → Prop)
    (h : ∀ i, MeasurableSet[badSiteSigma T] {ω | p i ω}) :
    MeasurableSet[badSiteSigma T] {ω | ∀ i, p i ω} := by
  let _ : MeasurableSpace Environment := badSiteSigma T
  change MeasurableSet {ω | ∀ i, p i ω}
  rw [show {ω | ∀ i, p i ω} = ⋂ i, {ω | p i ω} by ext; exact Set.mem_iInter.symm]
  exact MeasurableSet.iInter h

private theorem measurable_exists {T : ℝ} {ι : Type*} [Countable ι] (p : ι → Environment → Prop)
    (h : ∀ i, MeasurableSet[badSiteSigma T] {ω | p i ω}) :
    MeasurableSet[badSiteSigma T] {ω | ∃ i, p i ω} := by
  let _ : MeasurableSpace Environment := badSiteSigma T
  change MeasurableSet {ω | ∃ i, p i ω}
  rw [show {ω | ∃ i, p i ω} = ⋃ i, {ω | p i ω} by ext; exact Set.mem_iUnion.symm]
  exact MeasurableSet.iUnion h

private theorem measurable_reaches (T : ℝ) (u v : Lattice) :
    MeasurableSet[badSiteSigma T] {ω | v ∈ reachSet ω T u} := by
  classical
  let _ : MeasurableSpace Environment := badSiteSigma T
  change MeasurableSet {ω : Environment | ∃ (d : ℕ × ℕ) (q : Path u d),
    u + ((d.1 : ℤ), (d.2 : ℤ)) = v ∧
    ∀ i : Fin (d.1 + d.2 + 1), i.val < d.1 + d.2 → -T ≤ ω (q.vertex i)}
  apply measurable_exists (T := T)
  intro d
  apply measurable_exists (T := T)
  intro q
  by_cases hv : u + ((d.1 : ℤ), (d.2 : ℤ)) = v
  · simp only [hv, true_and]
    apply measurable_all (T := T)
    intro i
    by_cases hi : i.val < d.1 + d.2
    · simpa only [hi, true_implies, Set.compl_ofPred, not_lt] using
        (measurableSet_site_bad T (q.vertex i)).compl
    · simp [hi]
  · simp [hv]

private theorem measurable_finite_with_card_ge (T : ℝ) (r : Environment → Set Lattice)
    (hr : ∀ y, MeasurableSet[badSiteSigma T] {ω | y ∈ r ω}) (n : ℕ) :
    MeasurableSet[badSiteSigma T] {ω | (r ω).Finite ∧ n ≤ (r ω).ncard} := by
  classical
  have heq : {ω | (r ω).Finite ∧ n ≤ (r ω).ncard} =
      {ω | ∃ S : {F : Finset Lattice // n ≤ F.card}, r ω = (S.val : Set Lattice)} := by
    ext ω
    constructor
    · rintro ⟨hfin, hn⟩
      obtain ⟨S, hS⟩ := hfin.exists_finset_coe
      rw [← hS, Set.ncard_coe_finset] at hn
      exact ⟨⟨S, hn⟩, hS.symm⟩
    · rintro ⟨⟨S, hcard⟩, hS⟩
      change (r ω).Finite ∧ n ≤ (r ω).ncard
      rw [hS, Set.ncard_coe_finset]
      exact ⟨S.finite_toSet, hcard⟩
  rw [heq]
  apply measurable_exists (T := T)
  intro S
  have heq' : {ω | r ω = (S.val : Set Lattice)} = {ω | ∀ y, y ∈ r ω ↔ y ∈ S.val} := by
    ext ω
    exact Set.ext_iff
  rw [heq']
  apply measurable_all (T := T)
  intro y
  by_cases hy : y ∈ S.val
  · simpa only [hy, iff_true] using hr y
  · simpa only [hy, iff_false, Set.compl_ofPred] using (hr y).compl

/-- Forward trapping is measurable in the very-bad-site sigma-algebra. -/
theorem measurableSet_trapped (T : ℝ) (z : Lattice) :
    MeasurableSet[badSiteSigma T] {ω | (reachSet ω T z).Finite} := by
  simpa only [Nat.zero_le, and_true] using
    measurable_finite_with_card_ge T (fun ω => reachSet ω T z) (measurable_reaches T z) 0

/-- Backward trapping is measurable in the very-bad-site sigma-algebra. -/
theorem measurableSet_backward_trapped (T : ℝ) (z : Lattice) :
    MeasurableSet[badSiteSigma T] {ω | (reachBackSet ω T z).Finite} := by
  simpa only [Nat.zero_le, and_true] using
    measurable_finite_with_card_ge T (fun ω => reachBackSet ω T z) (fun y => measurable_reaches T y z) 0

private theorem measurable_no_bad_chain (T : ℝ) (S : Set Lattice) (d K : ℕ) :
    MeasurableSet[badSiteSigma T] {ω | noLongChain {z | z ∈ S ∧ ω z < -T} d K} := by
  classical
  let _ : MeasurableSpace Environment := badSiteSigma T
  apply MeasurableSet.of_compl
  simp only [Set.compl_ofPred, noLongChain, not_not]
  apply measurable_exists (T := T)
  intro f
  by_cases h : Function.Injective f ∧ (∀ i, f i ∈ S) ∧
    ∀ i : Fin (K + 1), 0 < i.val → ∃ j : Fin (K + 1), j.val < i.val ∧
      latticeDistance (f i) (f j) ≤ (d : ℤ)
  · have he : {ω : Environment | Function.Injective f ∧
          (∀ i, f i ∈ {z | z ∈ S ∧ ω z < -T}) ∧
          ∀ i : Fin (K + 1), 0 < i.val → ∃ j : Fin (K + 1), j.val < i.val ∧
            latticeDistance (f i) (f j) ≤ (d : ℤ)} = {ω | ∀ i, ω (f i) < -T} := by
      ext ω
      exact ⟨fun hf i => (hf.2.1 i).2, fun hbad => ⟨h.1, fun i => ⟨h.2.1 i, hbad i⟩, h.2.2⟩⟩
    rw [he]
    exact measurable_all (T := T) (fun i ω => ω (f i) < -T) (fun i => measurableSet_site_bad T (f i))
  · have he : {ω : Environment | Function.Injective f ∧
          (∀ i, f i ∈ {z | z ∈ S ∧ ω z < -T}) ∧
          ∀ i : Fin (K + 1), 0 < i.val → ∃ j : Fin (K + 1), j.val < i.val ∧
            latticeDistance (f i) (f j) ≤ (d : ℤ)} = ∅ := by
      apply Set.eq_empty_iff_forall_notMem.mpr
      rintro ω ⟨hi, hs, hc⟩
      exact h ⟨hi, fun i => (hs i).1, hc⟩
    rw [he]
    exact MeasurableSet.empty

private theorem measurable_reach_cutoff (T : ℝ) (r : Environment → Set Lattice)
    (hr : ∀ y, MeasurableSet[badSiteSigma T] {ω | y ∈ r ω}) (n : ℕ) :
    MeasurableSet[badSiteSigma T] {ω | (r ω).Finite → (r ω).ncard < n} := by
  have heq : {ω | (r ω).Finite → (r ω).ncard < n} = {ω | (r ω).Finite ∧ n ≤ (r ω).ncard}ᶜ := by
    ext ω
    exact ⟨fun h hf => (not_le.mpr (h hf.1)) hf.2, fun h hf => lt_of_not_ge fun hc => h ⟨hf, hc⟩⟩
  rw [heq]
  exact (measurable_finite_with_card_ge T r hr n).compl

/-- The staircase geometry event uses only very-bad-site indicators. -/
theorem measurableSet_goodEvent (θ₁ T : ℝ) (K₁ K₃ : ℕ) (Q : Set Lattice) :
    MeasurableSet[badSiteSigma T] (goodEvent θ₁ K₁ K₃ T Q) := by
  classical
  let _ : MeasurableSpace Environment := badSiteSigma T
  change MeasurableSet (_ ∩ _)
  apply MeasurableSet.inter (measurable_no_bad_chain T _ _ _)
  apply measurable_all (T := T)
  intro z
  by_cases hz : z ∈ collar Q (collarRadius θ₁ K₁ K₃)
  · simp only [hz, true_implies]
    change MeasurableSet (_ ∩ _)
    exact (measurable_reach_cutoff T (fun ω => reachSet ω T z) (measurable_reaches T z) (K₃ ^ 2)).inter
      (measurable_reach_cutoff T (fun ω => reachBackSet ω T z) (fun y => measurable_reaches T y z) (K₃ ^ 2))
  · simp [hz]

end LPPDifferentiability.StairGeometry
