module

public import Busemann.Frozen.Definitions.CoalescingTilt

@[expose] public section
open LPPDifferentiability

namespace LPP.Busemann

/-- The sigma algebra generated by the weights northeast of u, including its boundary.
Strong Existence, accepted source, lines 143–155. -/
@[instance_reducible]
def forwardWeightSigma (u : Lattice) : MeasurableSpace Environment :=
  MeasurableSpace.comap
    (fun ω : Environment => fun x : {x : Lattice // u ≤ x} => ω x.val)
    (inferInstance : MeasurableSpace ({x : Lattice // u ≤ x} → ℝ))

end LPP.Busemann
