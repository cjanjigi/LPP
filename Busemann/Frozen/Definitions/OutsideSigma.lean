module

public import Busemann.Frozen.Definitions.OutsideWeightsAndCocycleIncrements
public import Mathlib.MeasureTheory.Function.ConditionalExpectation.Basic

@[expose] public section

open LPPDifferentiability

namespace LPP.Busemann

/-- The field generated by the outside weights and cocycle unit increments. -/
@[instance_reducible] def outsideSigma {Ω : Type*} (weights : Ω → Environment)
    (B : Lattice → Lattice → Ω → ℝ) (V : Finset Lattice) : MeasurableSpace Ω :=
  MeasurableSpace.comap (outsideWeightsAndCocycleIncrements weights B V) inferInstance

end LPP.Busemann
