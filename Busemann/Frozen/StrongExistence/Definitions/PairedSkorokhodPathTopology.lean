module

public import Busemann.Frozen.StrongExistence.Definitions.PairedGraphVietorisGenerators

@[expose] public section
open MeasureTheory Filter LPPDifferentiability LPP.Busemann
open scoped ENNReal Topology
namespace LPP.Busemann

/-- The topology generated by upper and lower Vietoris sets of ordered-pair graphs. -/
@[instance_reducible]
def pairedSkorokhodPathTopology (S : Set ℝ) (J : Type*) :
    TopologicalSpace (PairedSkorokhodPath S J) :=
  TopologicalSpace.generateFrom (pairedGraphVietorisGenerators S J)

end LPP.Busemann
