module

public import Busemann.Frozen.Definitions.OutsideSigma
import Mathlib.MeasureTheory.MeasurableSpace.Constructions

/-! Measurability facts for the outside weights and cocycle field. -/

@[expose] public section

open MeasureTheory LPPDifferentiability

namespace LPP.Busemann

/-- If `U ⊆ V`, the field generated by the outside data for `V` is contained
in the field generated by the outside data for `U`. See GRS,
arXiv:1510.00860v1, Appendix A, reading lines 1440–1470. -/
theorem outsideSigma_antitone {Ω : Type*} (weights : Ω → Environment)
    (B : Lattice → Lattice → Ω → ℝ) {U V : Finset Lattice} (hUV : U ⊆ V) :
    outsideSigma weights B V ≤ outsideSigma weights B U := by
  let : MeasurableSpace Ω := outsideSigma weights B U
  have hArray :
      Measurable (outsideWeightsAndCocycleIncrements weights B V) := by
    apply measurable_pi_iff.mpr
    intro j
    cases j with
    | inl x =>
        -- A site outside `V` is also outside `U`.
        have hxU : x.1 ∉ U := by
          intro hx
          exact x.2 (hUV hx)
        change Measurable (fun ω : Ω => weights ω x.1)
        exact (measurable_pi_apply (Sum.inl ⟨x.1, hxU⟩)).comp
          (comap_measurable (outsideWeightsAndCocycleIncrements weights B U))
    | inr yi =>
        rcases yi with ⟨y, i⟩
        -- An edge root outside all `V` lower orthants is outside all `U` lower orthants.
        have hyU : y.1 ∈ outsideLowerOrthants U := by
          intro x hx
          exact y.2 x (hUV hx)
        change Measurable (fun ω : Ω => B y.1 (y.1 + finiteEdgeStep i) ω)
        exact (measurable_pi_apply (Sum.inr (⟨y.1, hyU⟩, i))).comp
          (comap_measurable (outsideWeightsAndCocycleIncrements weights B U))
  exact hArray.comap_le

/-- If every weight and cocycle coordinate is measurable in an ambient field,
then the outside field is contained in that field. See GRS,
arXiv:1510.00860v1, Appendix A, reading lines 1440–1470. -/
theorem outsideSigma_le {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (weights : Ω → Environment) (B : Lattice → Lattice → Ω → ℝ)
    (V : Finset Lattice)
    (hWeights : ∀ x, Measurable[mΩ] (fun ω : Ω => weights ω x))
    (hB : ∀ x y, Measurable[mΩ] (fun ω : Ω => B x y ω)) :
    outsideSigma weights B V ≤ mΩ := by
  have hArray :
      @Measurable Ω (OutsideIndex V → ℝ) mΩ inferInstance
        (outsideWeightsAndCocycleIncrements weights B V) := by
    let : MeasurableSpace Ω := mΩ
    apply measurable_pi_iff.mpr
    intro j
    cases j with
    | inl x => exact hWeights x.1
    | inr yi =>
        rcases yi with ⟨y, i⟩
        exact hB y.1 (y.1 + finiteEdgeStep i)
  simpa only [outsideSigma] using hArray.comap_le

/-- A weight outside `V` is measurable in the outside field. See GRS,
arXiv:1510.00860v1, Appendix A, reading lines 1440–1470. -/
theorem measurable_outside_weight {Ω : Type*} (weights : Ω → Environment)
    (B : Lattice → Lattice → Ω → ℝ) (V : Finset Lattice)
    (x : Lattice) (hx : x ∉ V) :
    Measurable[outsideSigma weights B V] (fun ω : Ω => weights ω x) := by
  let : MeasurableSpace Ω := outsideSigma weights B V
  exact (measurable_pi_apply (Sum.inl ⟨x, hx⟩)).comp
    (comap_measurable (outsideWeightsAndCocycleIncrements weights B V))

/-- A cocycle increment rooted outside every lower orthant of `V` is
measurable in the outside field. See GRS, arXiv:1510.00860v1,
Appendix A, reading lines 1440–1470. -/
theorem measurable_outside_cocycleIncrement {Ω : Type*}
    (weights : Ω → Environment) (B : Lattice → Lattice → Ω → ℝ)
    (V : Finset Lattice) (y : Lattice)
    (hy : y ∈ outsideLowerOrthants V) (i : Fin 2) :
    Measurable[outsideSigma weights B V]
      (fun ω : Ω => B y (y + finiteEdgeStep i) ω) := by
  let : MeasurableSpace Ω := outsideSigma weights B V
  exact (measurable_pi_apply (Sum.inr (⟨y, hy⟩, i))).comp
    (comap_measurable (outsideWeightsAndCocycleIncrements weights B V))

end LPP.Busemann
