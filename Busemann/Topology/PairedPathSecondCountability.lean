module

public import Busemann.Frozen.StrongExistence.Definitions.PairedSkorokhodPathTopologicalSpace
public import Mathlib.Topology.Sets.VietorisTopology
public import Mathlib.Topology.Bases

/-!
# Second countability of paired paths

The topology on paired paths is generated by upper and lower Vietoris
sets of their ordered-pair graphs.
-/

@[expose] public section
namespace LPP.Busemann

private theorem pairedPathSecondCountable_of_graphInducing
    (S : Set ℝ) (J : Type*)
    [SecondCountableTopology (SqueezedState J)]
    (G : PairedSkorokhodPath S J →
      TopologicalSpace.Compacts (SqueezedState J × SqueezedState J))
    (hTopology : pairedSkorokhodPathTopology S J =
      TopologicalSpace.induced G inferInstance) :
    SecondCountableTopology (PairedSkorokhodPath S J) := by
  have hInducing : Topology.IsInducing G := ⟨hTopology⟩
  exact hInducing.secondCountableTopology

/-- The ordered-graph Vietoris topology on paired paths is second countable.

This concerns the installed topology defined in
PairedSkorokhodPathTopologicalSpace.lean:10-12, whose generators are recorded
in PairedGraphVietorisGenerators.lean:11-16.
-/
theorem pairedSkorokhodPath_secondCountableTopology
    (S : Set ℝ) (J : Type*) [Countable J] :
    SecondCountableTopology (PairedSkorokhodPath S J) := by
  -- Bundle each path's ordered-pair graph with the compactness already in its carrier.
  let graphCompactification :
      PairedSkorokhodPath S J →
        TopologicalSpace.Compacts (SqueezedState J × SqueezedState J) :=
    fun f => ⟨pairedPathOrderGraph S J f, f.2⟩

  -- The generators are exactly the preimages of the upper and lower
  -- Vietoris generators on compact subsets of the squeezed-state pair space.
  have hTopology :
      pairedSkorokhodPathTopology S J =
        TopologicalSpace.induced graphCompactification inferInstance := by
    change TopologicalSpace.generateFrom (pairedGraphVietorisGenerators S J) =
      TopologicalSpace.induced graphCompactification
        (TopologicalSpace.induced
          (fun K : TopologicalSpace.Compacts (SqueezedState J × SqueezedState J) =>
            (K : Set (SqueezedState J × SqueezedState J)))
          (TopologicalSpace.vietoris (SqueezedState J × SqueezedState J)))
    let graphValues : PairedSkorokhodPath S J →
        Set (SqueezedState J × SqueezedState J) :=
      fun f => (graphCompactification f : Set (SqueezedState J × SqueezedState J))
    have hUpper (U : Set (SqueezedState J × SqueezedState J)) :
        Set.preimage graphValues (Set.powerset U) =
          {f | pairedPathOrderGraph S J f ⊆ U} := by
      ext f
      change (graphCompactification f : Set (SqueezedState J × SqueezedState J)) ⊆ U ↔ _
      change pairedPathOrderGraph S J f ⊆ U ↔ _
      rfl
    have hLower (U : Set (SqueezedState J × SqueezedState J)) :
        Set.preimage graphValues {K | (K ∩ U).Nonempty} =
          {f | (pairedPathOrderGraph S J f ∩ U).Nonempty} := by
      ext f
      change ((graphCompactification f : Set (SqueezedState J × SqueezedState J)) ∩ U).Nonempty ↔ _
      change (pairedPathOrderGraph S J f ∩ U).Nonempty ↔ _
      rfl
    have hGenerators :
        pairedGraphVietorisGenerators S J =
          Set.preimage graphValues ''
            (Set.powerset ''
                {U : Set (SqueezedState J × SqueezedState J) | IsOpen U} ∪
              (fun U : Set (SqueezedState J × SqueezedState J) =>
                {K | (K ∩ U).Nonempty}) ''
                {U : Set (SqueezedState J × SqueezedState J) | IsOpen U}) := by
      ext V
      constructor
      · intro hV
        rcases hV with ⟨U, hU, rfl⟩ | ⟨U, hU, rfl⟩
        · exact ⟨Set.powerset U, Or.inl ⟨U, hU, rfl⟩, hUpper U⟩
        · exact ⟨{K | (K ∩ U).Nonempty}, Or.inr ⟨U, hU, rfl⟩, hLower U⟩
      · rintro ⟨X, hX, hPreimage⟩
        rcases hX with hX | hX
        · rcases hX with ⟨U, hU, rfl⟩
          have hOpen : IsOpen U := by simpa using hU
          left
          refine ⟨U, hOpen, ?_⟩
          calc
            V = Set.preimage graphValues (Set.powerset U) := hPreimage.symm
            _ = {f | pairedPathOrderGraph S J f ⊆ U} := hUpper U
        · rcases hX with ⟨U, hU, rfl⟩
          have hOpen : IsOpen U := by simpa using hU
          right
          refine ⟨U, hOpen, ?_⟩
          calc
            V = Set.preimage graphValues {K | (K ∩ U).Nonempty} := hPreimage.symm
            _ = {f | (pairedPathOrderGraph S J f ∩ U).Nonempty} := hLower U
    rw [induced_compose, TopologicalSpace.vietoris, induced_generateFrom_eq]
    rw [hGenerators]
    simp only [graphValues, Function.comp_def]

  -- Countability of J makes the function space, its product with time, and
  -- the induced squeezed-state topology second countable.
  have hAmbient : SecondCountableTopology (ℝ × (J → ℝ)) := inferInstance
  have hState : SecondCountableTopology (SqueezedState J) := by
    change @SecondCountableTopology (SqueezedState J) (squeezedStateTopology J)
    exact @TopologicalSpace.secondCountableTopology_induced
      (SqueezedState J) (ℝ × (J → ℝ)) inferInstance hAmbient
      (squeezedStateEmbedding J)

  -- Products and the compact-set Vietoris space preserve second countability;
  -- the exact equality transfers it to the installed topology.
  exact @pairedPathSecondCountable_of_graphInducing
    S J hState graphCompactification hTopology

end LPP.Busemann
