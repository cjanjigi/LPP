module

public import Busemann.Frozen.StrongExistence.Definitions.EvalPlus
public import Busemann.Topology.SqueezedStateLimits
public import Mathlib.Topology.Bases

@[expose] public section
open MeasureTheory
open scoped Topology
namespace LPP.Busemann

private theorem squeezedFinite_state_eq
    {J : Type*} {x y : J → ℝ} {t u : ℝ}
    (h : SqueezedState.finite x t = SqueezedState.finite y u) : x = y := by
  have hstate := congrArg
    (fun z : SqueezedState J => match z with
      | .finite state _ => state
      | .bottom => fun _ => (0 : ℝ)
      | .top => fun _ => (0 : ℝ)) h
  simpa using hstate

private theorem squeezedFinite_time_eq
    {J : Type*} {x y : J → ℝ} {t u : ℝ}
    (h : SqueezedState.finite x t = SqueezedState.finite y u) : t = u := by
  have htime := congrArg
    (fun z : SqueezedState J => match z with
      | .finite _ time => time
      | .bottom => (0 : ℝ)
      | .top => (0 : ℝ)) h
  simpa using htime

private theorem pairedTraceLE_finite_time_le
    {S : Set ℝ} {J : Type*} (f : RawPairedTrace S J)
    {x y : J → ℝ} {t u : ℝ}
    (h : pairedTraceLE S f (.finite x t) (.finite y u)) : t ≤ u := by
  rcases h with hEqual | hBottom | hTop | hStrict | hJump
  · have htime : t = u := by
      exact squeezedFinite_time_eq hEqual
    exact htime.le
  · cases hBottom
  · cases hTop
  · rcases hStrict with ⟨x', y', t', u', hx, hy, hlt⟩
    have htime : t = t' := squeezedFinite_time_eq hx
    have huTime : u = u' := squeezedFinite_time_eq hy
    rw [htime, huTime]
    exact hlt.le
  · rcases hJump with ⟨s, hx, hy⟩
    have htime : t = s.val := squeezedFinite_time_eq hx
    have huTime : u = s.val := squeezedFinite_time_eq hy
    rw [htime, huTime]

/-- The graph-pair test at two sampled times is measurable in precisely the
sigma algebra generated by the sampled minus and plus scalar evaluations.
This is the omitted finite-sample helper for the parent generated-sigma
argument, not the full paired-path Borel equality. -/
theorem measurableSet_squeezedFiniteSampleGraphPair_hit_open
    (S : Set ℝ) (J : Type*) [Countable J] (hS : IsClosed S)
    (D : Set {v : ℝ // v ∈ S})
    (t u : {v : ℝ // v ∈ S}) (ht : t ∈ D) (hu : u ∈ D)
    (minus₁ minus₂ : Bool)
    (U : Set (SqueezedState J × SqueezedState J)) (hU : IsOpen U) :
    @MeasurableSet (PairedSkorokhodPath S J)
      (MeasurableSpace.generateFrom
        {A : Set (PairedSkorokhodPath S J) |
          ∃ s : {v : ℝ // v ∈ S}, s ∈ D ∧
            ∃ j : J, ∃ V : Set ℝ, IsOpen V ∧
              (A = {f | evalMinus f s j ∈ V} ∨
               A = {f | evalPlus f s j ∈ V})})
      {f : PairedSkorokhodPath S J |
      let z : SqueezedState J × SqueezedState J :=
        (SqueezedState.finite
            (if minus₁ then evalMinus f t else evalPlus f t) t.val,
          SqueezedState.finite
            (if minus₂ then evalMinus f u else evalPlus f u) u.val)
      z ∈ pairedPathOrderGraph S J f ∧ z ∈ U} := by
  classical
  have _hS : IsClosed S := hS
  -- Work directly in the parent-generated sigma, with no native-Borel substitution.
  let : MeasurableSpace (PairedSkorokhodPath S J) :=
    MeasurableSpace.generateFrom
      {A : Set (PairedSkorokhodPath S J) |
        ∃ s : {v : ℝ // v ∈ S}, s ∈ D ∧
          ∃ j : J, ∃ V : Set ℝ, IsOpen V ∧
            (A = {f | evalMinus f s j ∈ V} ∨
             A = {f | evalPlus f s j ∈ V})}

  -- Countability and the induced state topology give the actual Borel product structure.
  let : SecondCountableTopology (J → ℝ) := inferInstance
  let : SecondCountableTopology (ℝ × (J → ℝ)) := inferInstance
  let : SecondCountableTopology (SqueezedState J) :=
    TopologicalSpace.secondCountableTopology_induced
      (SqueezedState J) (ℝ × (J → ℝ))
      (squeezedStateEmbedding J)
  let : MeasurableSpace (SqueezedState J) := borel (SqueezedState J)
  let : BorelSpace (SqueezedState J) := ⟨rfl⟩

  -- Each open scalar preimage is one of the displayed generators.
  have hEvalMinus (s : {v : ℝ // v ∈ S}) (hs : s ∈ D) (j : J) :
      Measurable (fun f : PairedSkorokhodPath S J => evalMinus f s j) := by
    apply measurable_of_isOpen
    intro V hV
    refine MeasurableSpace.GenerateMeasurable.basic _ ?_
    exact ⟨s, hs, j, V, hV, Or.inl rfl⟩
  have hEvalPlus (s : {v : ℝ // v ∈ S}) (hs : s ∈ D) (j : J) :
      Measurable (fun f : PairedSkorokhodPath S J => evalPlus f s j) := by
    apply measurable_of_isOpen
    intro V hV
    refine MeasurableSpace.GenerateMeasurable.basic _ ?_
    exact ⟨s, hs, j, V, hV, Or.inr rfl⟩

  -- Assemble each full trace from its measurable scalar coordinates.
  have hMinusTrace (s : {v : ℝ // v ∈ S}) (hs : s ∈ D) :
      Measurable (fun f : PairedSkorokhodPath S J => evalMinus f s) := by
    apply measurable_pi_iff.mpr
    intro j
    exact hEvalMinus s hs j
  have hPlusTrace (s : {v : ℝ // v ∈ S}) (hs : s ∈ D) :
      Measurable (fun f : PairedSkorokhodPath S J => evalPlus f s) := by
    apply measurable_pi_iff.mpr
    intro j
    exact hEvalPlus s hs j

  let x : PairedSkorokhodPath S J → J → ℝ := fun f =>
    if minus₁ then evalMinus f t else evalPlus f t
  let y : PairedSkorokhodPath S J → J → ℝ := fun f =>
    if minus₂ then evalMinus f u else evalPlus f u
  have hx : Measurable x := by
    by_cases hminus : minus₁
    · simpa [x, hminus] using hMinusTrace t ht
    · simpa [x, hminus] using hPlusTrace t ht
  have hy : Measurable y := by
    by_cases hminus : minus₂
    · simpa [y, hminus] using hMinusTrace u hu
    · simpa [y, hminus] using hPlusTrace u hu

  -- The constructor is continuous for the actual squeezed-state topology.
  let stateX : PairedSkorokhodPath S J → SqueezedState J :=
    fun f => SqueezedState.finite (x f) t.val
  let stateY : PairedSkorokhodPath S J → SqueezedState J :=
    fun f => SqueezedState.finite (y f) u.val
  have hStateX : Measurable stateX := by
    exact (continuous_squeezedState_finite J).measurable.comp
      (hx.prodMk measurable_const)
  have hStateY : Measurable stateY := by
    exact (continuous_squeezedState_finite J).measurable.comp
      (hy.prodMk measurable_const)
  let z : PairedSkorokhodPath S J → SqueezedState J × SqueezedState J :=
    fun f => (stateX f, stateY f)
  have hz : Measurable z := hStateX.prodMk hStateY
  let openHit : Set (PairedSkorokhodPath S J) := {f | z f ∈ U}
  have hOpenHit : MeasurableSet openHit := by
    change MeasurableSet {f | z f ∈ U}
    exact hU.measurableSet.preimage hz

  -- The equal-time plus-to-minus case reduces to equality of the two traces.
  have hTraceEqual : MeasurableSet
      {f : PairedSkorokhodPath S J | evalPlus f t = evalMinus f t} :=
    measurableSet_eq_fun (hPlusTrace t ht) (hMinusTrace t ht)
  have hReverseEqualOrder (f : PairedSkorokhodPath S J) :
      pairedTraceLE S f.1 (.finite (evalPlus f t) t.val)
        (.finite (evalMinus f t) t.val) ↔ evalPlus f t = evalMinus f t := by
    constructor
    · intro hOrder
      rcases hOrder with hEqual | hBottom | hTop | hStrict | hJump
      · have hState :
            SqueezedState.finite (evalPlus f t) t.val =
              SqueezedState.finite (evalMinus f t) t.val := hEqual
        exact squeezedFinite_state_eq hState
      · cases hBottom
      · cases hTop
      · rcases hStrict with ⟨x', y', t', u', hx', hy', hlt⟩
        have hFalse : False := by
          cases hx'
          cases hy'
          exact lt_irrefl _ hlt
        exact hFalse.elim
      · rcases hJump with ⟨s, hx', _⟩
        have htime : t.val = s.val := squeezedFinite_time_eq hx'
        have hs : s = t := Subtype.ext htime.symm
        subst s
        have hState :
            SqueezedState.finite (evalPlus f t) t.val =
              SqueezedState.finite (evalMinus f t) t.val := hx'
        exact squeezedFinite_state_eq hState
    · intro hEqual
      exact Or.inl (congrArg (fun v : J → ℝ => SqueezedState.finite v t.val) hEqual)

  let graphHit : Set (PairedSkorokhodPath S J) :=
    {f | z f ∈ pairedPathOrderGraph S J f}
  have hFirstInGraph (f : PairedSkorokhodPath S J) :
      (z f).1 ∈ pairedTraceGraph S f.1 := by
    change SqueezedState.finite (if minus₁ then evalMinus f t else evalPlus f t)
      t.val ∈ pairedTraceGraph S f.1
    cases minus₁
    · simp only [pairedTraceGraph, Set.mem_ofPred_eq]
      exact Or.inr (Or.inr ⟨t, Or.inr rfl⟩)
    · simp only [ite_true, pairedTraceGraph, Set.mem_ofPred_eq]
      exact Or.inr (Or.inr ⟨t, Or.inl rfl⟩)
  have hSecondInGraph (f : PairedSkorokhodPath S J) :
      (z f).2 ∈ pairedTraceGraph S f.1 := by
    change SqueezedState.finite (if minus₂ then evalMinus f u else evalPlus f u)
      u.val ∈ pairedTraceGraph S f.1
    cases minus₂
    · simp only [pairedTraceGraph, Set.mem_ofPred_eq]
      exact Or.inr (Or.inr ⟨u, Or.inr rfl⟩)
    · simp only [ite_true, pairedTraceGraph, Set.mem_ofPred_eq]
      exact Or.inr (Or.inr ⟨u, Or.inl rfl⟩)

  have hGraphIff (f : PairedSkorokhodPath S J) :
      z f ∈ pairedPathOrderGraph S J f ↔
        pairedTraceLE S f.1 (z f).1 (z f).2 := by
    change (z f).1 ∈ pairedTraceGraph S f.1 ∧
      (z f).2 ∈ pairedTraceGraph S f.1 ∧
      pairedTraceLE S f.1 (z f).1 (z f).2 ↔ _
    constructor
    · exact fun h => h.2.2
    · intro hOrder
      exact ⟨hFirstInGraph f, hSecondInGraph f, hOrder⟩

  -- Convert graph membership into univ, empty, or the measurable equality set.
  have hGraphSetOfOrder
      (hOrder : ∀ f : PairedSkorokhodPath S J,
        pairedTraceLE S f.1 (z f).1 (z f).2) :
      graphHit = Set.univ := by
    ext f
    change z f ∈ pairedPathOrderGraph S J f ↔ True
    constructor
    · intro _
      trivial
    · intro _
      exact (hGraphIff f).mpr (hOrder f)
  have hGraphSetOfNoOrder
      (hNoOrder : ∀ f : PairedSkorokhodPath S J,
        ¬ pairedTraceLE S f.1 (z f).1 (z f).2) :
      graphHit = ∅ := by
    ext f
    change z f ∈ pairedPathOrderGraph S J f ↔ False
    constructor
    · intro hGraph
      exact hNoOrder f ((hGraphIff f).mp hGraph)
    · exact False.elim
  have hGraphSetOfTraceEquality
      (hOrderEq : ∀ f : PairedSkorokhodPath S J,
        pairedTraceLE S f.1 (z f).1 (z f).2 ↔
          evalPlus f t = evalMinus f t) :
      graphHit = {f | evalPlus f t = evalMinus f t} := by
    ext f
    change z f ∈ pairedPathOrderGraph S J f ↔
      evalPlus f t = evalMinus f t
    exact (hGraphIff f).trans (hOrderEq f)

  -- The target event is the graph hit intersected with the open-pair preimage.
  change MeasurableSet (graphHit ∩ openHit)
  by_cases htime : t.val = u.val
  · have hsubtype : t = u := Subtype.ext htime
    subst u
    cases minus₁ <;> cases minus₂
    · -- Equal-time plus-to-plus samples lie on the diagonal of the graph.
      have hGraph : graphHit = Set.univ :=
        hGraphSetOfOrder (fun _ => Or.inl rfl)
      rw [hGraph]
      simpa using hOpenHit
    · -- Equal-time plus-to-minus order holds exactly when the traces agree.
      have hGraph : graphHit = {f | evalPlus f t = evalMinus f t} :=
        hGraphSetOfTraceEquality (fun f => hReverseEqualOrder f)
      rw [hGraph]
      exact hTraceEqual.inter hOpenHit
    · -- The graph directs the equal-time minus-to-plus jump.
      have hOrder : ∀ f : PairedSkorokhodPath S J,
          pairedTraceLE S f.1 (z f).1 (z f).2 := by
        intro f
        exact Or.inr (Or.inr (Or.inr (Or.inr ⟨t, rfl, rfl⟩)))
      have hGraph : graphHit = Set.univ := hGraphSetOfOrder hOrder
      rw [hGraph]
      simpa using hOpenHit
    · -- Equal-time minus-to-minus samples lie on the diagonal of the graph.
      have hGraph : graphHit = Set.univ :=
        hGraphSetOfOrder (fun _ => Or.inl rfl)
      rw [hGraph]
      simpa using hOpenHit
  · have hTimeCases : t.val < u.val ∨ u.val < t.val := lt_or_gt_of_ne htime
    rcases hTimeCases with hlt | hgt
    · -- Strictly increasing times satisfy the strict-time order clause.
      have hOrder : ∀ f : PairedSkorokhodPath S J,
          pairedTraceLE S f.1 (z f).1 (z f).2 := by
        intro f
        change pairedTraceLE S f.1
          (.finite (x f) t.val) (.finite (y f) u.val)
        exact Or.inr (Or.inr (Or.inr (Or.inl ⟨x f, y f, t.val, u.val,
          rfl, rfl, hlt⟩)))
      have hGraph : graphHit = Set.univ := hGraphSetOfOrder hOrder
      rw [hGraph]
      simpa using hOpenHit
    · -- A decreasing pair of finite times cannot lie in the chronological graph.
      have hNoOrder : ∀ f : PairedSkorokhodPath S J,
          ¬ pairedTraceLE S f.1 (z f).1 (z f).2 := by
        intro f hOrder
        have hle : t.val ≤ u.val := pairedTraceLE_finite_time_le f.1 hOrder
        exact (not_le_of_gt hgt) hle
      have hGraph : graphHit = ∅ := hGraphSetOfNoOrder hNoOrder
      rw [hGraph]
      simp

end LPP.Busemann
